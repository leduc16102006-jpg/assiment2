# ==========================================
# 1. CẤU HÌNH DATABASE (PostgreSQL 16)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=brewlite_db

# ==========================================
# 2. CẤU HÌNH BACKEND (apps/api - NestJS)
# ==========================================
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brewlite_db?schema=public"
JWT_SECRET="brewlite_jwt_secret_key_change_me"

# Cấu hình VNPay Sandbox
VNPAY_TMN_CODE=your_tmn_code_here
VNPAY_HASH_SECRET=your_hash_secret_here
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay/return

# ==========================================
# 3. CẤU HÌNH FRONTEND (apps/web - Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3000