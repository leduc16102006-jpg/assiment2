
@startuml ActivityCheckout
title Task 2.1 - Activity Diagram: End-to-End Checkout Workflow

skinparam shadowing false
skinparam activity {
    BackgroundColor White
    BorderColor #555555
    DiamondBackgroundColor #FFF2CC
    DiamondBorderColor #B8860B
    ArrowColor #555555
}
skinparam partition {
    BorderColor #888888
    BackgroundColor #F8F9FA
}

|Customer|
start
:Mở ứng dụng BrewLite;

|Frontend|
:Hiển thị trang chủ và menu;

|Customer|
:Xem danh mục đồ uống;
:Chọn sản phẩm;

|Frontend|
:Hiển thị chi tiết sản phẩm;

|Customer|
:Chọn Size và Topping;
:Thêm sản phẩm vào giỏ hàng;

|Frontend|
:Cập nhật và lưu thông tin giỏ hàng;

|Customer|
:Truy cập giỏ hàng;

|Frontend|
:Hiển thị danh sách món và tổng tiền;

|Customer|
:Kiểm tra / điều chỉnh giỏ hàng;

if (Có mã khuyến mãi?) then (Có)
    |Customer|
    :Nhập mã giảm giá;

    |Frontend|
    :Ghi nhận mã khuyến mãi;
else (Không)
    |Frontend|
    :Tiếp tục không áp dụng mã;
endif

|Customer|
:Nhấn xác nhận đặt hàng;

|Frontend|
if (Khách hàng đã đăng nhập?) then (Có)
    :Tiếp tục quy trình đặt hàng;
else (Không)
    :Chuyển hướng đến trang đăng nhập;

    |Customer|
    :Nhập email và mật khẩu;

    |Frontend|
    :Gửi yêu cầu đăng nhập;

    |Backend|
    :Xác thực thông tin đăng nhập;

    while (Đăng nhập thất bại?) is (Có)
        |Frontend|
        :Hiển thị thông báo đăng nhập thất bại;

        |Customer|
        :Nhập lại thông tin đăng nhập;

        |Frontend|
        :Gửi lại yêu cầu đăng nhập;

        |Backend|
        :Xác thực lại thông tin đăng nhập;
    endwhile (Không)

    |Frontend|
    :Thông báo đăng nhập thành công;
    :Quay lại trang giỏ hàng;

    |Customer|
    :Nhấn xác nhận đặt hàng;
endif

|Frontend|
:Gửi yêu cầu tạo đơn hàng;

|Backend|
:Kiểm tra mã khuyến mãi (nếu có);
:Kiểm tra tình trạng tồn kho;

while (Tồn kho không đủ?) is (Có)
    |Frontend|
    :Hiển thị banner vàng cảnh báo;
    :Giữ nguyên giỏ hàng;

    |Customer|
    :Điều chỉnh giỏ hàng;
    :Xác nhận đặt hàng lại;

    |Frontend|
    :Gửi lại yêu cầu tạo đơn hàng;

    |Backend|
    :Kiểm tra mã khuyến mãi (nếu có);
    :Kiểm tra tình trạng tồn kho;
endwhile (Không)

|Backend|
:Tạo đơn hàng với trạng thái PENDING;
:Trả kết quả tạo đơn thành công;

|Customer|
:Chọn thanh toán qua VNPay;

|Frontend|
:Gửi yêu cầu tạo thanh toán;

|Backend|
:Khởi tạo yêu cầu thanh toán;
:Trả về đường dẫn thanh toán;

|Frontend|
:Chuyển hướng đến VNPay Sandbox;

|VNPay Sandbox|
:Hiển thị giao diện thanh toán;

|Customer|
:Thực hiện hoặc hủy thanh toán;

|VNPay Sandbox|
:Trả kết quả giao dịch;

|Backend|
:Xử lý kết quả thanh toán;

|Frontend|
if (Thanh toán thành công?) then (Có)
    :Hiển thị màn hình xác nhận đơn hàng;
    :Hiển thị mã đơn và trạng thái PAID;

    |Customer|
    :Xem thông tin xác nhận đơn hàng;
else (Không / Hủy)
    |Frontend|
    :Hiển thị thông báo thanh toán thất bại;
    :Giữ nguyên thông tin giỏ hàng;

    |Customer|
    :Quay lại giỏ hàng;
endif

stop

@enduml