@startuml
' BrewLite - Sơ đồ Use-case tổng quát - Task 1.2
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam handwritten false
skinparam roundCorner 0
skinparam linetype polyline
header Task 1.2
title SƠ ĐỒ USE-CASE TỔNG QUÁT

actor "Khách hàng" as KH
rectangle "«actor»\nVNPay Sandbox" as VNP

rectangle "Hệ thống BrewLite" {
  usecase "Xem danh sách đồ uống" as Menu
  usecase "Xem chi tiết sản phẩm" as Detail
  usecase "Chọn size / topping" as Options
  usecase "Quản lý giỏ hàng" as Cart
  usecase "Đăng ký tài khoản" as Register
  usecase "Đăng nhập" as Login
  usecase "Đặt và thanh toán đơn" as Checkout
  usecase "Xem trạng thái / lịch sử" as History
  usecase "Áp dụng mã khuyến mãi" as Promotion
  usecase "Thanh toán qua VNPay" as Payment
  usecase "Ghi nhận điểm thưởng" as Loyalty
}

KH -- Menu
KH -- Detail
KH -- Options
KH -- Cart
KH -- Register
KH -- Login
KH -- Checkout
KH -- History
VNP -- Payment

Checkout ..> Payment : <<include>>
Promotion ..> Checkout : <<extend>>
Loyalty ..> Payment : <<extend>> [PAID]
@enduml
