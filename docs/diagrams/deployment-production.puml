@startuml DeploymentProduction
left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName "Arial"
skinparam packageStyle rectangle

title Task 3.2 - UML DEPLOYMENT DIAGRAM: BREWLITE (LOCAL, CI/CD & PRODUCTION)

' ==========================================
' 1. MÔI TRƯỜNG LOCAL (Từ docker-compose.yml)
' ==========================================
node "1. LOCAL ENVIRONMENT (Developer Machine)" as LocalEnv {
  node "Docker Compose (docker-compose.yml)" as DockerCompose {
    artifact "brewlite_web_local\n(Next.js 16 ./apps/web)\n[Port 3000:3000]" as LocalFE
    artifact "brewlite_api_local\n(NestJS 12 ./apps/api)\n[Port 10000:10000 | Auto Migrate]" as LocalBE
    database "brewlite_postgres_local\n(postgres:16)\n[Port 5432:5432 | DB: brewlite_db]" as LocalDB
    storage "Docker Volume: postgres_data_local\n(/var/lib/postgresql/data)" as LocalVol

    LocalFE --> LocalBE : HTTP REST (:10000)\nNEXT_PUBLIC_API_URL
    LocalBE --> LocalDB : TCP (:5432)\npostgres:5432/brewlite_db
    LocalDB -- LocalVol : Persistent Mount
  }
}

' ==========================================
' 2. MÔI TRƯỜNG CI/CD & CONTAINER REGISTRY
' ==========================================
node "2. CI/CD & CONTAINER REGISTRY (GitHub)" as CIEnv {
  node "GitHub Actions Runner\n(ci.yml & cd.yml)" as GHA {
    component "CI/CD Quality Gate\n(Migrate, Seed, Lint, Test, E2E, Build)\n+ Smoke Test & Rollback Check" as CIJob
  }
  node "GitHub Container Registry (GHCR)\n[ghcr.io]" as GHCR {
    artifact "leduc16102006-jpg/assiment2-api\nTags: <SHA>, <SemVer>, latest" as DockerImg
  }
  CIJob --> DockerImg : Build & Push Image (HTTPS :443)
}

' ==========================================
' 3. MÔI TRƯỜNG PRODUCTION (Vercel + Render + Neon)
' ==========================================
node "3. PRODUCTION ENVIRONMENT" as ProdEnv {

  node "Thiết bị Người dùng\n(Mobile / Desktop)" as ClientDevice {
    component "Web Browser / Next.js PWA\n(Mobile-First UI, Manifest + PNG Icons,\nHybrid Guest/DB Cart)" as ClientPWA
  }

  cloud "Vercel Platform (Frontend Hosting & CDN)" as VercelCloud {
    node "Vercel Edge CDN\n(Branch Tracking: main)" as VercelCDN {
      artifact "BrewLite Next.js 16 / PWA\nhttps://assiment2.vercel.app\n(Build từ ./apps/web)" as ProdFE
    }
    file "Vercel Env Vars\n(NEXT_PUBLIC_API_URL)" as VercelEnv
    component "Vercel Runtime & Access Logs" as VercelLogs

    VercelEnv ..> ProdFE : Inject at Build/Runtime
    ProdFE ..> VercelLogs : Write Logs
  }

  cloud "Render Platform (Backend Web Service)" as RenderCloud {
    node "Render Docker Container\n(brewlite-api)" as RenderBEHost {
      artifact "NestJS 12 API Server\nhttps://brewlite-api-5dmc.onrender.com\n[Port: 10000 | Startup: prisma migrate deploy]\n(Swagger: /api/docs | Cron: OrdersExpiryJob)" as ProdBE
      component "Health Check & Smoke Test\n(GET /health)" as HealthCheck
      component "Render Log Stream\n(NestJS Logger / Stdout)" as RenderLogs
    }

    file "Render Environment Variables & Secrets\n(PORT=10000, DATABASE_URL, JWT_SECRET,\nFRONTEND_URL, VNPAY_TMN_CODE,\nVNPAY_HASH_SECRET, VNPAY_PAYMENT_URL,\nVNPAY_RETURN_URL)" as RenderSecrets

    RenderSecrets ..> ProdBE : Inject at Runtime
    HealthCheck ..> ProdBE : HTTP Ping (:10000/health)
    ProdBE ..> RenderLogs : Stream Logs
  }

  cloud "Neon.tech (Serverless PostgreSQL)" as NeonCloud {
    database "PostgreSQL 16 (Neon)\n(13 Prisma Tables)\n[SSL: sslmode=require]" as ProdDB
  }

  cloud "External Payment Gateway" as ExtGateway {
    node "VNPay Sandbox\n(sandbox.vnpayment.vn)" as VNPay
  }

  ClientPWA <--> ProdFE : HTTPS (:443)\nStatic Assets & PWA
  ClientPWA <--> ProdBE : HTTPS (:443 -> :10000)\nREST API + Bearer JWT + Idempotency-Key
  ClientPWA --> VNPay : HTTPS (:443)\nRedirect to Payment URL
  VNPay --> ProdBE : HTTPS (:443)\nGET /payments/vnpay/ipn (HMAC-SHA512)
  VNPay --> ProdBE : HTTPS (:443)\nBrowser Return -> /payments/vnpay/return
  ProdBE --> ClientPWA : HTTP 302 Redirect\nFRONTEND_URL/order-confirmation
  ProdBE --> ProdDB : TLS/SSL TCP (:5432)\nPrisma ORM via DATABASE_URL
}

DockerImg ..> RenderBEHost : Pull :latest Image via Deploy Hook (HTTPS)
CIJob ..> RenderBEHost : Trigger Deploy Hook & Smoke Test (/health)

@enduml