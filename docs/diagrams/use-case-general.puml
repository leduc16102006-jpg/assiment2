@startuml UseCaseGeneral
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "DejaVu Sans"
skinparam roundCorner 0
skinparam packageStyle rectangle

header Task 1.2
title SƠ ĐỒ USE-CASE TỔNG QUÁT - BREWLITE

actor "Khách hàng\n(Customer)" as Customer
actor "Barista / Nhân viên quầy\n(Future)" as Barista
actor "VNPay Sandbox\n«external system»" as Gateway

rectangle "HỆ THỐNG BREWLITE" {
  usecase "UC-01: Xem menu &\ntìm kiếm đồ uống" as UC01
  usecase "UC-02: Xem chi tiết &\nchọn size/topping" as UC02
  usecase "UC-03: Quản lý giỏ hàng" as UC03
  usecase "UC-04: Đăng ký /\nĐăng nhập" as UC04
  usecase "UC-05: Đặt hàng &\nThanh toán" as UC05
  usecase "UC-06: Xem lịch sử /\ntrạng thái đơn" as UC06
  usecase "UC-07: Áp dụng\nmã giảm giá" as UC07
  usecase "UC-08: Xử lý thanh toán" as UC08

  package "Future / Out-of-scope for MVP" {
    usecase "UC-09: Tiếp nhận đơn" as UC09
    usecase "UC-10: Cập nhật trạng thái\npha chế" as UC10
  }
}

Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC04
Customer -- UC05
Customer -- UC06

UC02 ..> UC01 : <<extend>>
UC05 ..> UC04 : <<include>>
UC05 ..> UC08 : <<include>>
UC07 ..> UC05 : <<extend>>

Gateway -- UC08
Barista -- UC09
Barista -- UC10

note right of UC08
  VNPay Sandbox chỉ được gọi
  khi chọn phương thức VNPay.
  Ví/Thẻ mô phỏng xử lý nội bộ.
end note

@enduml