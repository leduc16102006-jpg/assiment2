@startuml UseCaseGeneral
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Customer\n(Khách hàng)" as Customer
actor "Barista / Staff\n(Nhân viên)" as Staff <<Outside MVP>>
actor "Payment Gateway\n(Cổng thanh toán)" as Payment

rectangle "BrewLite System" {

    package "Menu & Product" {
        usecase "Xem danh mục\nđồ uống" as UC01
        usecase "Tìm kiếm và lọc\nsản phẩm" as UC02
        usecase "Xem chi tiết\nsản phẩm" as UC03
        usecase "Tùy chỉnh Size\nvà Topping" as UC04
    }

    package "Cart & Ordering" {
        usecase "Quản lý\ngiỏ hàng" as UC05
        usecase "Đặt hàng" as UC06
        usecase "Kiểm tra\ntồn kho" as UC07
    }

    package "Account & Payment" {
        usecase "Đăng ký tài khoản" as UC08
        usecase "Đăng nhập" as UC09
        usecase "Thanh toán đơn hàng" as UC10
        usecase "Xử lý kết quả\nthanh toán" as UC11
    }

    package "Order Management" {
        usecase "Xem lịch sử\nđơn hàng" as UC12
        usecase "Xem chi tiết\nđơn hàng" as UC13
        usecase "Theo dõi trạng thái\nđơn hàng" as UC14
        usecase "Cập nhật trạng thái\nđơn hàng" as UC15
    }
}

Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC06
Customer --> UC08
Customer --> UC09
Customer --> UC10
Customer --> UC12
Customer --> UC13
Customer --> UC14

UC06 ..> UC07 : <<include>>
UC10 ..> UC11 : <<include>>

Payment --> UC11

Staff --> UC15

note right of Staff
  Ngoài phạm vi MVP
end note

@enduml